# worklog v2 environment template — copy to .env and fill in.
# Loaded automatically by alembic/env.py and services/storage/postgres.py
# via python-dotenv (existing shell exports always win).

# ---------------------------------------------------------------------------
# Required — Postgres (Supabase Cloud)
# ---------------------------------------------------------------------------
#
# Supabase exposes THREE connection modes. v2 uses the SESSION POOLER:
#
#   1. Direct (db.<ref>.supabase.co:5432)
#      - IPv6-only on the free tier. Network unreachable on most home/office
#        networks unless you pay for the IPv4 add-on.
#      - Supports SET LOCAL ROLE.
#
#   2. Session pooler (aws-0-<region>.pooler.supabase.com:5432)
#      - IPv4 + IPv6. Free tier compatible.
#      - Supports SET LOCAL ROLE (each client holds a dedicated server
#        connection during the session). Works with asyncpg prepared
#        statements.
#      - USE THIS for both vars below.
#      - Username has the form `postgres.<PROJECTREF>` (not bare `postgres`).
#
#   3. Transaction pooler (aws-0-<region>.pooler.supabase.com:6543)
#      - IPv4 + IPv6. But: breaks SET LOCAL ROLE (no session state) and
#        breaks asyncpg prepared statements. Unusable for v2 RLS.
#
# Get the exact URL from: Supabase dashboard → Settings → Database →
# Connection Pooling → Session mode.

# Admin/service-role connection used by alembic migrations and `wl team`
# provisioning.
WORKLOG_DB_SERVICE_ROLE_KEY=postgresql://postgres.YOURREF:REPLACE_ME@aws-0-YOURREGION.pooler.supabase.com:5432/postgres

# Per-user runtime connection. Solo dev: same URL as above. Team deployments:
# each user has their own Postgres role and URL.
WORKLOG_DB_URL=postgresql://postgres.YOURREF:REPLACE_ME@aws-0-YOURREGION.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Optional — runtime tuning
# ---------------------------------------------------------------------------

# WORKLOG_DB_POOL_SIZE=5
# WORKLOG_DB_POOL_OVERFLOW=5

# ---------------------------------------------------------------------------
# Inference (v1 vars, still honored in v2 — seeds the `local` provider route)
# ---------------------------------------------------------------------------

# WORKLOG_INFERENCE_URL=http://127.0.0.1:8080/v1
# WORKLOG_INFERENCE_MODEL=
# WORKLOG_INFERENCE_API_KEY=
# WORKLOG_INFERENCE_TIMEOUT=120

# ---------------------------------------------------------------------------
# Paths (defaults to repo root)
# ---------------------------------------------------------------------------

# WORKLOG_HOME=
# WORKLOG_PROMPTS=
# WORKLOG_CONFIG=
