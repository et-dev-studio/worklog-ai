# worklog v2 environment template — copy to .env and fill in.
# Loaded automatically by alembic/env.py and services/storage/postgres.py
# via python-dotenv (existing shell exports always win).

# ---------------------------------------------------------------------------
# Required — Postgres (Supabase Cloud)
# ---------------------------------------------------------------------------

# Admin/service-role connection used by alembic migrations and `wl team`
# provisioning. MUST be the direct/session connection (port 5432), not the
# transaction pooler (6543) — DDL and SET ROLE need session state.
WORKLOG_DB_SERVICE_ROLE_KEY=postgresql://postgres:REPLACE_ME@db.YOURPROJECT.supabase.co:5432/postgres

# Per-user runtime connection. For solo dev this can equal the service-role
# URL above. For team deployments each user has their own role + URL.
# Avoid the transaction pooler (port 6543): it breaks SET LOCAL ROLE and
# asyncpg prepared statements.
WORKLOG_DB_URL=postgresql://postgres:REPLACE_ME@db.YOURPROJECT.supabase.co:5432/postgres

# ---------------------------------------------------------------------------
# Optional — runtime tuning
# ---------------------------------------------------------------------------

# WORKLOG_DB_POOL_SIZE=5
# WORKLOG_DB_POOL_OVERFLOW=5

# ---------------------------------------------------------------------------
# Inference (v1 vars, still honored in v2 — seeds the `local` provider route)
# ---------------------------------------------------------------------------

# WORKLOG_INFERENCE_URL=http://127.0.0.1:8080/v1
# WORKLOG_INFERENCE_MODEL=
# WORKLOG_INFERENCE_API_KEY=
# WORKLOG_INFERENCE_TIMEOUT=120

# ---------------------------------------------------------------------------
# Paths (defaults to repo root)
# ---------------------------------------------------------------------------

# WORKLOG_HOME=
# WORKLOG_PROMPTS=
# WORKLOG_CONFIG=
